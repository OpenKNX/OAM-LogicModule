    "version": "2.0.0",
    "tasks": [
        {
            "label": "\u2714 (release)",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "useCurrent"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "\u2714 (debug)",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "-DebugBuild",
                "useCurrent"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "\u2794 (release)",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "useCurrent",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "\u2794 (debug)",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "-DebugBuild",
                "useCurrent",
                "upload"
            ],
            "presentation": {
                "panel": "shared"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "\u2794\u2794 upload only",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "-DebugBuild",
                "useCurrent",
                "uploadOnly"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start Monitor",
            "type": "shell",
            "command": "pio device monitor",
            "dependsOn": ["\u2794 (debug)"],
            "group": "build",
        },
        {
            "label": "Develop RP2040",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "develop_RP2040"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Upload JLINK RP2040",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "upload_JLINK_RP2040",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Upload USB RP2040",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "upload_USB_RP2040",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Create Dependencies",
            "type": "shell",
            "command": "lib/OGM-Common/scripts/setup/reusable/Build-Dependencies.ps1",
            "args": [],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "OpenKNXproducer",
            "type": "shell",
            "command": "~/bin/OpenKNXproducer.exe",
            "args": [
                "create",
                "--Debug",
                "--HeaderFileName",
                "include/knxprod.h",
                "src/Logikmodul"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build-Release-Package",
            "type": "shell",
            "command": "scripts/Build-Release-Package.ps1",
            "args": [],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build-Release",
            "type": "shell",
            "command": "scripts/Build-Release.ps1",
            "args": [
                "Release"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build-Beta",
            "type": "shell",
            "command": "scripts/Build-Release.ps1",
            "args": [],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "resolve platformio.ini",
            "type": "shell",
            "command": "~/.platformio/penv/Scripts/pio",
            "args": [
                "project",
                "config",
                ">platformio.ini.full.txt"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}